{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-motion-studio/schemas/storyboard.schema.json",
  "title": "Audio Motion Storyboard",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "language",
    "durationMs",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "startMs",
          "endMs",
          "narration",
          "onScreenText",
          "visualKind",
          "animation",
          "visualAssetRequirements",
          "semanticRationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 1
          },
          "narration": {
            "type": "string"
          },
          "onScreenText": {
            "type": "string"
          },
          "visualKind": {
            "enum": [
              "editorial",
              "network",
              "signal",
              "shield",
              "process",
              "reciprocity",
              "metric"
            ]
          },
          "animation": {
            "type": "string"
          },
          "visualAssetRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semanticRationale": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "reviewed"
            ]
          },
          "composition": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,80}$"
          },
          "engine": {
            "enum": [
              "remotion",
              "three"
            ]
          },
          "options": {
            "type": "object"
          },
          "transitionIn": {
            "type": "object",
            "required": [
              "type",
              "durationMs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "crossfade",
                  "push",
                  "wipe",
                  "camera-pull",
                  "zoom-through",
                  "match-cut"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              },
              "easing": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
